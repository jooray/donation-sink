<?php
/**
 * Donation Sink Configuration Template
 *
 * Copy this file to config.php and fill in your values.
 * IMPORTANT: config.php should NEVER be committed to version control.
 */

return [
    /**
     * Database path - MUST be outside webroot for security
     * The SQLite database will be created automatically on first use
     */
    'database_path' => '/path/outside/webroot/donations.db',

    /**
     * Seed phrase for wallet generation
     * Generate using: php generate-seed.php
     * This is a 12-word BIP39 mnemonic phrase
     * KEEP THIS SECRET - anyone with this seed can access all donations
     */
    'seed_phrase' => 'word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12',

    /**
     * Lightning address where melted funds will be sent
     * Format: username@domain.com
     */
    'lightning_address' => 'donations@example.com',

    /**
     * Mints this sink is willing to accept donations from.
     *
     * The mint URL is read out of the token the donor sends, and this script then
     * connects to it — so an empty list means strangers choose what your server talks to.
     * Leaving it empty is supported and restricts connections to public HTTPS mints,
     * which is enough to stop the endpoint being used to probe your internal network.
     * Naming the mints you actually expect is stronger, and costs nothing:
     *
     *   'accepted_mints' => ['https://mint.example.com', 'https://mint.other.org'],
     */
    'accepted_mints' => [],

    /**
     * Auto-melt thresholds per currency unit
     * When a mint+unit balance reaches this threshold, automatically melt to Lightning
     *
     * Units:
     * - sat: satoshis (Bitcoin base unit)
     * - usd: cents (100 = $1.00)
     * - eur: cents (100 = €1.00)
     */
    'melt_thresholds' => [
        'sat' => 500,      // Melt when balance reaches 500 sats
        'usd' => 100,      // Melt when balance reaches 100 cents ($1.00)
        'eur' => 100,      // Melt when balance reaches 100 cents (€1.00)
    ],

    /**
     * Log file path for recording donations and melt operations
     * MUST be writable by the web server
     */
    'log_path' => '/path/outside/webroot/donations.log',

    /**
     * Default threshold for unknown currency units
     * If a donation comes in with a unit not listed in melt_thresholds,
     * use this value (in that unit's base denomination)
     */
    'default_melt_threshold' => 100,

    /**
     * ---------------------------------------------------------------------
     * Everything below is optional. Leave it out entirely and the sink works
     * exactly as it always has: SQLite for the wallet, no second database.
     * ---------------------------------------------------------------------
     */

    /**
     * Project names.
     *
     * A donation can say who it is for:
     *
     *   curl -X POST https://example.com/donation-sink.php \
     *        -H 'Content-Type: application/json' \
     *        -d '{"token":"cashuB...","project":"some-project"}'
     *
     * The project also works as a form field or as `?project=...` in the query
     * string. Nothing has to be configured first: the first donation that names a
     * project creates it. A name is lowercased and must be 1 to 64 characters of
     * ASCII letters, digits, dot, dash or underscore, starting with a letter or a
     * digit. A donation with no project keeps working and is recorded as unnamed.
     */
    'project' => [
        // Refuse anything longer than this (1-64).
        'max_length' => 64,

        // Leave empty to accept any well-formed name, which is the point of the
        // feature. Fill it in only if you would rather have a fixed list:
        //   'allowed' => ['website', 'podcast'],
        'allowed' => [],

        // Attribute donations that name no project to this one instead of leaving
        // them unnamed. Useful when the sink serves a single project.
        'default' => null,
    ],

    /**
     * Accounting database (MariaDB or MySQL, through PDO).
     *
     * This is a SEPARATE database from the wallet. The wallet stays in SQLite at
     * `database_path` and nothing in the accounting code ever opens it. If this
     * database is down, misconfigured or simply not created yet, donations are
     * still accepted and swapped as normal; the failure goes to the log and
     * nowhere else.
     *
     * Create it with schema.sql, or leave `auto_migrate` on and let the first
     * donation create the tables (which needs a database user with CREATE).
     */
    'accounting' => [
        'enabled'  => false,
        'dsn'      => 'mysql:host=localhost;dbname=donation_sink;charset=utf8mb4',
        'username' => 'donation_sink',
        'password' => 'put the database password here',

        // Seconds to wait for a connection. Kept short on purpose: a donor should
        // not be left waiting on a database that is not answering.
        'timeout'  => 3,

        // Create the schema when a table is missing. Turn this off once the schema
        // exists and the database user has only SELECT, INSERT, UPDATE, DELETE.
        'auto_migrate' => true,
    ],

    /**
     * Dashboard (dashboard.php).
     *
     * IT HAS NO LOGIN OF ITS OWN. Put HTTP basic auth in front of it in the web
     * server before enabling it - see README.md, "Protecting the dashboard".
     * While `require_web_auth` is true the page refuses to render unless the web
     * server has authenticated somebody, which catches the obvious accident but
     * is not itself a lock.
     */
    'dashboard' => [
        'enabled'          => false,
        'require_web_auth' => true,

        // Timezone the page groups days, months and years in. UTC is what the
        // database stores, and the only value with no daylight-saving caveat.
        'timezone'         => 'UTC',

        'title'            => 'Donations',

        // Most projects to list. Anything past this is cut from the bottom.
        'max_projects'     => 200,
    ],
];
